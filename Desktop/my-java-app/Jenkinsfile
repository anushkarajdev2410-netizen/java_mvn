pipeline {
agent any


tools {
    jdk 'JDK-21'
    maven 'Maven-3.10.0'
}

environment {
    PROJECT_DIR = 'Desktop/my-java-app'
}

stages {
    stage('1. Checkout and Verify') {
        steps {
            echo 'Verifying checked-out project...'

            sh '''
                set -eu

                echo "Workspace: $WORKSPACE"
                echo "Java version:"
                java -version

                echo "Java compiler version:"
                javac -version

                echo "Maven version:"
                mvn -version

                echo "Checking project files..."
                test -f "$WORKSPACE/$PROJECT_DIR/pom.xml"
                test -f "$WORKSPACE/$PROJECT_DIR/Jenkinsfile"

                echo "pom.xml and Jenkinsfile found."
            '''
        }
    }

    stage('2. Build') {
        steps {
            echo 'Compiling Java application...'

            dir("${PROJECT_DIR}") {
                sh 'mvn clean compile'
            }
        }
    }

    stage('3. Unit Test') {
        steps {
            echo 'Running unit tests...'

            dir("${PROJECT_DIR}") {
                sh 'mvn test'
            }
        }

        post {
            always {
                junit allowEmptyResults: true,
                      testResults: 'Desktop/my-java-app/target/surefire-reports/*.xml'
            }
        }
    }

    stage('4. Package') {
        steps {
            echo 'Packaging application...'

            dir("${PROJECT_DIR}") {
                sh 'mvn package -DskipTests'
            }

            archiveArtifacts(
                artifacts: 'Desktop/my-java-app/target/*.jar',
                fingerprint: true
            )
        }
    }

    stage('5. Deploy') {
        steps {
            echo 'Copying application artifact...'

            sh '''
                set -eu

                mkdir -p "$WORKSPACE/deployment"

                JAR_FILE=$(find "$WORKSPACE/$PROJECT_DIR/target" \
                    -maxdepth 1 -type f -name '*.jar' \
                    ! -name '*-sources.jar' \
                    ! -name '*-javadoc.jar' \
                    | head -n 1)

                if [ -z "$JAR_FILE" ]; then
                    echo "ERROR: No application JAR was generated."
                    exit 1
                fi

                cp "$JAR_FILE" "$WORKSPACE/deployment/app.jar"

                echo "Artifact copied successfully."
                ls -lh "$WORKSPACE/deployment/app.jar"
            '''
        }
    }
}

post {
    success {
        echo 'Pipeline completed successfully!'
    }

    failure {
        echo 'Pipeline failed. Check the first actual error in Console Output.'
    }
}


}

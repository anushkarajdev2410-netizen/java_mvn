
pipeline {
    agent any

    tools {
        jdk 'JDK-21'
        maven 'Maven-3.10.0'
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('2. Build') {
            steps {
                echo 'Compiling Java application...'
                sh 'mvn clean compile'
            }
        }

        stage('3. Unit Test') {
            steps {
                echo 'Running unit tests...'
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('4. Package') {
            steps {
                echo 'Packaging application...'
                sh 'mvn package -DskipTests'
                archiveArtifacts artifacts: 'target/*.jar',
                                 fingerprint: true
            }
        }

        stage('5. Deploy') {
            steps {
                echo 'Deploying application artifact...'
                sh '''
                    mkdir -p "$WORKSPACE/deployment"
                    cp target/*.jar "$WORKSPACE/deployment/app.jar"
                    echo "Artifact copied to deployment directory."
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console logs.'
        }
    }
}
